# ── Server ──────────────────────────────────────────────────────────
WEALTH_HOST=0.0.0.0
WEALTH_PORT=8082
WEALTH_PUBLIC_BASE_URL=http://localhost:8082

# ── Market Data (optional — core capital math works without these) ──
# Frankfurter API for FX rates (free, no key needed)
# World Bank API for macro indicators (free, no key needed)

# ── Quick Start ─────────────────────────────────────────────────────
