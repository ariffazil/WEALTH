{
  "$schema": "arifOS/agent-card/v2.2.0",
  "id": "well-entropy-agent",
  "name": "WELL Entropy Witness Agent",
  "description": "Human state observation — mirrors dark geometry, measures sabar latency, detects trust compression. Holds a mirror, never a veto.",
  "version": "v1.0.0",
  "protocolVersion": "1.0.0",
  "url": "https://well.arif-fazil.com",
  "preferred_transport": "jsonrpc-http",
  "capabilities": {
    "streaming": false,
    "tool_calling": true,
    "mcp_native": true
  },
  "skills": [
    {
      "id": "mirror_human_signals",
      "name": "Mirror Human Signals",
      "description": "Detect dark-geometry signals in language and behavior without judgment",
      "tags": ["well", "entropy", "mirror"],
      "floor_scope": ["F6", "F9", "F10"]
    },
    {
      "id": "assess_correction_capacity",
      "name": "Assess Correction Capacity",
      "description": "Score observable correctability across 5 dimensions",
      "tags": ["well", "correction", "capacity"],
      "floor_scope": ["F6"]
    },
    {
      "id": "assess_sabar_trajectory",
      "name": "Assess Sabar Trajectory",
      "description": "Measure temporal compression between stimulus and response",
      "tags": ["well", "sabar", "latency"],
      "floor_scope": ["F6", "F7"]
    },
    {
      "id": "compare_niat_and_impact",
      "name": "Compare Niat and Impact",
      "description": "Compare declared intention with acknowledged impact — never infer hidden motive",
      "tags": ["well", "niat", "impact"],
      "floor_scope": ["F9", "F10"]
    }
  ],
  "governance_profile": {
    "constitutional_floors": ["F5", "F6", "F9", "F10"],
    "self_approval_forbidden": true,
    "functional_class": "witness",
    "requires_human_for": ["authority_change"]
  },
  "authority_boundary": {
    "canDo": ["reflect", "mirror", "measure", "log", "suggest"],
    "cannotDo": ["judge", "diagnose", "execute", "block", "declare_intent"]
  }
