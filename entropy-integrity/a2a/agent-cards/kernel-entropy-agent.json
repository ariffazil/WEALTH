{
  "$schema": "arifOS/agent-card/v2.2.0",
  "id": "kernel-entropy-agent",
  "name": "Entropy Integrity Kernel Agent",
  "description": "Constitutional entropy assessment — routes evidence, computes J-state, governs action posture. Never diagnoses, never seals autonomously.",
  "version": "v1.0.0",
  "protocolVersion": "1.0.0",
  "url": "https://arifos.arif-fazil.com",
  "preferred_transport": "jsonrpc-http",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "tool_calling": true,
    "mcp_native": true
  },
  "skills": [
    {
      "id": "route_entropy_investigation",
      "name": "Route Entropy Investigation",
      "description": "Route domain questions to the correct organ based on signal class and content",
      "tags": ["entropy", "routing", "governance"],
      "floor_scope": ["F4", "F11"]
    },
    {
      "id": "assess_j_state",
      "name": "Assess J-State",
      "description": "Fuse organ observations into 5-plane judgment-integrity map using minimum-floor aggregation",
      "tags": ["entropy", "assessment", "governance"],
      "floor_scope": ["F2", "F4", "F7", "F9"]
    },
    {
      "id": "request_independent_challenge",
      "name": "Request Independent Challenge",
      "description": "Generate neutral challenge and record/classify response",
      "tags": ["entropy", "correction", "probe"],
      "floor_scope": ["F2", "F6"]
    },
    {
      "id": "prepare_hold_recommendation",
      "name": "Prepare HOLD Recommendation",
      "description": "Convert J-state into action posture — VOID/HOLD/BOUNDED_PROCEED/PROCEED_WITNESSED",
      "tags": ["entropy", "governance", "gate"],
      "floor_scope": ["F1", "F13"]
    }
  ],
  "governance_profile": {
    "constitutional_floors": ["F1", "F2", "F4", "F7", "F9", "F10", "F11", "F13"],
    "self_approval_forbidden": true,
    "functional_class": "assessor",
    "requires_human_for": ["irreversible_action", "vault999_seal"]
  },
  "authority_boundary": {
    "canDo": ["observe", "assess", "route", "probe", "recommend"],
    "cannotDo": ["seal", "execute", "diagnose", "declare_intent", "permanent_classify"]
  }
}
