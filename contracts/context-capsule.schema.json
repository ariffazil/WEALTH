{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wealth://contracts/context-capsule.schema.json",
  "title": "ContextCapsule",
  "type": "object",
  "required": ["capsule_id", "origin", "objective", "domains", "facts", "created_at"],
  "properties": {
    "capsule_id": {
      "type": "string",
      "description": "Unique capsule ID. Format: caps-{source}-{name}-{seq}."
    },
    "origin": {
      "type": "string",
      "enum": ["GEOX", "WEALTH", "arifOS", "WELL", "A-FORGE", "AAA", "USER"],
      "description": "Source of this capsule."
    },
    "objective": {
      "type": "string",
      "description": "What decision or computation this capsule enables."
    },
    "domains": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Knowledge domains involved: geology, infrastructure, capital, law, energy, climate, social."
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "support"],
        "properties": {
          "claim": {"type": "string"},
          "support": {
            "type": "array",
            "items": {"type": "string", "format": "uri"}
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Explicit assumptions made in constructing this capsule."
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Known gaps in evidence or model."
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Binding constraints: jurisdictional, fiscal, physical, legal."
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Time-to-live for this capsule. Default: 604800 (7 days)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}