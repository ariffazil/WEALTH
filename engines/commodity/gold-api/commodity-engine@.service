[Unit]
Description=WEALTH Commodity Engine — %i
Documentation=https://github.com/ariffazil/WEALTH/tree/main/engines/commodity
PartOf=wealth.service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/html/%i/api
ExecStart=/usr/bin/node /var/www/html/%i/api/server.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/commodity-%i.log
StandardError=append:/var/log/commodity-%i-error.log
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
